<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - Manage Movies</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #121212;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #e0e0e0;
        }

        h1, h3 {
            color: #ffffff;
            font-weight: 700;
        }

        .container {
            background: #1f1f1f;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            margin-top: 40px;
            margin-bottom: 40px;
        }

        form input, form textarea, form select {
            background-color: #2c2c2c;
            color: #ffffff;
            border-radius: 8px;
            border: 1px solid #444;
            padding: 12px;
            font-size: 16px;
            transition: border-color 0.3s, background-color 0.3s;
        }

        form input:focus, form textarea:focus, form select:focus {
            background-color: #333;
            border-color: #4caf50;
            box-shadow: none;
            color: #fff;
        }

        button[type="submit"] {
            padding: 12px;
            font-size: 18px;
            font-weight: bold;
            transition: background-color 0.3s, transform 0.2s;
            background-color: #28a745;
            border: none;
        }

        button[type="submit"]:hover {
            background-color: #218838;
            transform: scale(1.02);
        }

        .table {
            background: #1f1f1f;
            border-radius: 8px;
            overflow: hidden;
            color: #e0e0e0;
        }

        .table th, .table td {
            vertical-align: middle !important;
            background-color: #2a2a2a;
        }

        .table img {
            border-radius: 8px;
            object-fit: cover;
        }

        .btn-primary {
            background-color: #007bff;
            border: none;
        }

        .btn-primary:hover {
            background-color: #0069d9;
        }

        .btn-danger {
            background-color: #dc3545;
            border: none;
        }

        .btn-danger:hover {
            background-color: #c82333;
        }

        .thead-dark th {
            background-color: #343a40;
            color: #ffffff;
        }

        a.btn {
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="my-5 text-center">
            threy_viran
            <img src="https://img.icons8.com/?size=100&id=pIPl8tqh3igN&format=png&color=000000" alt="Icon" style="width:40px; height:auto; margin-left:10px;">
        </h1>
        

        <h3 class="my-4">Add New Movie</h3>
        <form method="POST" action="/admin/add" class="mb-5">
            <input type="text" name="name" class="form-control mb-2" placeholder="Movie Name" required>

            <input type="text" name="thumbnail" class="form-control mb-2" placeholder="Thumbnail URL" required>

            <textarea name="description" class="form-control mb-2" placeholder="Movie Description" rows="3" required></textarea>

            <select name="category" class="form-control mb-2" required>
                <option value="">-- Select Category --</option>
                <option value="Action">Action</option>
                <option value="Comedy">Comedy</option>
                <option value="Drama">Drama</option>
                <option value="Horror">Horror</option>
                <option value="Sci-Fi">Sci-Fi</option>
                <option value="Romance">Romance</option>
                <option value="Adventure">Adventure</option>
                <option value="Thriller">Thriller</option>
                <option value="Animation">Animation</option>
                <option value="Fantasy">Fantasy</option>
            </select>

            <input type="text" name="link" class="form-control mb-2" placeholder="Movie Link" required>

            <button type="submit" class="btn btn-success btn-block">➕ Add Movie</button>
        </form>

        <h3 class="my-4">Manage Movies</h3>
        <table class="table table-bordered table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Thumbnail</th>
                    <th>Movie Name</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% movies.forEach(function(movie) { %>
                    <tr>
                        <td><img src="<%= movie.thumbnail %>" alt="Thumbnail" width="100"></td>
                        <td><%= movie.name %></td>
                        <td><%= movie.category %></td>
                        <td>
                            <a href="/edit/<%= movie.id %>" class="btn btn-primary btn-sm">✏️ Edit</a>
                            <a href="/delete/<%= movie.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this movie?')">🗑️ Delete</a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= movie.name %> - Movie Details</title>
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

  <style>
    /* Dark Mode Styles */
    body, html {
      margin: 0;
      padding: 0;
      background-color: #0d1117;
      font-family: 'Poppins', Arial, sans-serif;
      color: #c9d1d9;
    }

    .container {
      background-color: #161b22;
      padding: 40px 30px;
      border-radius: 15px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      margin-top: 40px;
      margin-bottom: 40px;
      max-width: 800px;
    }

    h1, h3, h4 {
      font-weight: 700;
      color: #58a6ff;
    }

    img.img-fluid {
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.7);
      transition: transform 0.3s ease;
    }

    img.img-fluid:hover {
      transform: scale(1.02);
    }

    a.btn-secondary {
      background-color: #30363d;
      border-color: #30363d;
      font-weight: 600;
      transition: background-color 0.3s ease;
      color: #c9d1d9;
    }

    a.btn-secondary:hover {
      background-color: #484f58;
      border-color: #484f58;
      color: #ffffff;
    }

    a.btn-success {
      background-color: #238636;
      border-color: #2ea043;
      font-weight: 600;
      margin-top: 10px;
      transition: background-color 0.3s ease;
      color: #ffffff;
    }

    a.btn-success:hover {
      background-color: #2ea043;
      border-color: #2ea043;
    }

    .border {
      border: 1px solid #30363d;
    }

    .rounded {
      border-radius: 10px;
    }

    .p-3 {
      background-color: #21262d;
    }

    form input.form-control, form textarea.form-control {
      background-color: #0d1117;
      border: 1px solid #30363d;
      color: #c9d1d9;
      border-radius: 8px;
      transition: border-color 0.3s, box-shadow 0.3s;
    }

    form input.form-control:focus, form textarea.form-control:focus {
      border-color: #58a6ff;
      box-shadow: 0 0 5px rgba(88, 166, 255, 0.5);
      background-color: #161b22;
    }

    button.btn-primary {
      background-color: #1f6feb;
      border-color: #1f6feb;
      font-weight: 600;
      width: 100%;
      transition: background-color 0.3s ease;
      margin-top: 10px;
      padding: 12px;
      color: #ffffff;
    }

    button.btn-primary:hover {
      background-color: #388bfd;
      border-color: #388bfd;
    }

    p {
      font-size: 1.05rem;
    }

    .mb-4 p strong {
      color: #79c0ff;
    }

    /* Comments Section */
    .border.rounded.p-3.mb-3 {
      background-color: #161b22;
      border: 1px solid #30363d;
      box-shadow: 0 3px 8px rgba(0,0,0,0.5);
    }

    /* Responsive Adjustments */
    @media (max-width: 768px) {
      .container {
        padding: 20px 15px;
      }
    }
  </style>

</head>
<body>

  <div class="container my-5">
    <a href="/" class="btn btn-secondary mb-4">← Back to Home</a>

    <h1 class="mb-4"><%= movie.name %></h1>
    <img src="<%= movie.thumbnail %>" class="img-fluid rounded mb-4" alt="<%= movie.name %>">

    <div class="mb-4">
      <p><strong>Description:</strong> <%= movie.description %></p>
      <p><strong>Category:</strong> <%= movie.category %></p>
      <a href="<%= movie.link %>" class="btn btn-success" target="_blank">🎬 Watch Now</a>
    </div>

    <!-- Comments Section -->
    <h3 class="mt-5">Comments</h3>

    <% if (typeof comments !== 'undefined' && comments.length > 0) { %>
      <% comments.forEach(function(comment) { %>
        <div class="border rounded p-3 mb-3">
          <p><strong><%= comment.username %>:</strong> <%= comment.comment %></p>
        </div>
      <% }); %>
    <% } else { %>
      <p>No comments yet. Be the first to comment!</p>
    <% } %>

    <!-- Add Comment Form -->
    <h4 class="mt-4">Add Your Comment</h4>
    <form method="POST" action="/movie/<%= movie.id %>/comment">
      <div class="form-group">
        <input type="text" name="username" placeholder="Your Name" class="form-control" required>
      </div>
      <div class="form-group">
        <textarea name="comment" placeholder="Your Comment" class="form-control" rows="4" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Post Comment</button>
    </form>

  </div>

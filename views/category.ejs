<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= categoryName %> Movies</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #111;
            color: #fff;
            padding: 20px;
            margin: 0;
            box-sizing: border-box;
        }
        h1, h2 {
            color: #00ffcc;
            font-size: 2rem;
        }
        .movie-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .movie {
            background-color: #222;
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease, background-color 0.3s ease;
        }
        .movie:hover {
            background-color: #333;
            transform: scale(1.03);
        }
        .movie img {
            width: 100%;
            height: auto;
            border-radius: 6px;
        }
        h3 {
            font-size: 1.2rem;
            margin-top: 10px;
            color: #fff;
        }
        a {
            text-decoration: none;
            color: #00ffcc;
        }
        a:hover {
            color: #fff;
        }
        .back-btn {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 20px;
            background-color: #00ffcc;
            color: #111;
            border-radius: 5px;
            text-align: center;
            font-size: 1rem;
            text-decoration: none;
        }
        .back-btn:hover {
            background-color: #00b3a3;
        }
    </style>
</head>
<body>

    <h1><%= categoryName %> Movies</h1>

    <h2>🔥 Latest Movie</h2>
    <% if (latestMovie) { %>
        <div class="movie">
            <a href="/movie/<%= latestMovie.id %>">
                <img src="<%= latestMovie.thumbnail %>" alt="<%= latestMovie.name %>">
                <h3><%= latestMovie.name %></h3>
            </a>
        </div>
    <% } %>

    <h2>🎬 All Movies in <%= categoryName %></h2>
    <div class="movie-grid">
        <% movies.forEach(movie => { %>
            <div class="movie">
                <a href="/movie/<%= movie.id %>">
                    <img src="<%= movie.thumbnail %>" alt="<%= movie.name %>">
                    <h3><%= movie.name %></h3>
                </a>
            </div>
        <% }) %>
    </div>

    <a href="/" class="back-btn">⬅️ Back to Home</a>

</body>
</html>
